# Alamat layanan API yang dituju server Next ketika meneruskan permintaan.
#
# Dibaca pada saat server dinyalakan, bukan pada saat aplikasi dibangun, dan
# tidak pernah ikut terkirim ke peramban. Nilai bawaannya cocok untuk
# pengembangan lokal; di dalam docker compose nilainya http://api:8000 dan
# sudah disetel pada berkas compose.
VISIONQC_API_ORIGIN=http://localhost:8000
