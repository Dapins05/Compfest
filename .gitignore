# Bahan lomba dan dokumen yang tidak dibutuhkan untuk menjalankan sistem
Persyaratan/
docs/

# ── Bobot model & artefak training (R4.2) ────────────────────
*.pt
*.pth
*.onnx
*.engine
*.pb
*.tflite
# Bobot model tidak masuk git karena ukurannya, tetapi daftar resminya harus.
# models.json memuat sidik jari SHA-256 yang dipakai memverifikasi unduhan;
# tanpa berkas itu di dalam git, keaslian bobot tidak dapat diperiksa siapa pun.
AI_model/models/**
!AI_model/models/
!AI_model/models/models.json
AI_model/data/
runs/
wandb/
lightning_logs/

# ── Hasil eksperimen ─────────────────────────────────────────
# CATATAN: isi AI_model/reports/ SENGAJA ikut di-commit. Gambar evaluasi
# (kurva training, confusion matrix, verifikasi anotasi) dan berkas metrik
# adalah bukti fine-tuning yang diwajibkan panitia — F-16 / R7.3. Bobot model
# dan dataset tetap dikecualikan di atas karena ukurannya, bukan perannya.
AI_model/notebooks/*.ipynb_checkpoints

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

