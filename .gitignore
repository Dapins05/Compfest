# Bahan lomba dan dokumen yang tidak dibutuhkan untuk menjalankan sistem.
Persyaratan/

# Cuplikan himpunan data tidak ikut disebarkan: isinya potongan citra MVTec AD
# yang berlisensi CC BY-NC-SA. Yang disertakan adalah skrip pembangkitnya,
# AI_model/scripts/preview_dataset.py, sehingga gambarnya dapat dibuat ulang
# oleh siapa pun yang sudah mengunduh sendiri himpunan datanya.
AI_model/reports/figures/dataset_samples_*.png
penilaian/

# Naskah proposal beserta berkas jadinya tidak ikut; yang ikut hanya KODE
# pembangkit diagramnya, supaya setiap gambar pada naskah dapat ditelusuri ke
# skrip yang menghasilkannya alih-alih muncul tanpa asal-usul.
docs/*
!docs/proposal/
docs/proposal/*
!docs/proposal/src/
docs/proposal/src/*
!docs/proposal/src/gen_diagrams.py
!docs/proposal/src/flowchart.py

# ── Bobot model & artefak training (R4.2) ────────────────────
*.pt
*.pth
*.onnx
*.engine
*.pb
*.tflite
# Bobot model tidak masuk git karena ukurannya, tetapi daftar resminya harus.
# models.json memuat sidik jari SHA-256 yang dipakai memverifikasi unduhan;
# tanpa berkas itu di dalam git, keaslian bobot tidak dapat diperiksa siapa pun.
AI_model/models/**
!AI_model/models/
!AI_model/models/models.json
AI_model/data/
runs/
wandb/
lightning_logs/

# ── Hasil eksperimen ─────────────────────────────────────────
# CATATAN: isi AI_model/reports/ SENGAJA ikut di-commit. Gambar evaluasi
# (kurva training, confusion matrix, verifikasi anotasi) dan berkas metrik
# adalah bukti fine-tuning yang diwajibkan panitia — F-16 / R7.3. Bobot model
# dan dataset tetap dikecualikan di atas karena ukurannya, bukan perannya.
AI_model/notebooks/*.ipynb_checkpoints

